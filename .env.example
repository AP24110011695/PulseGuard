# PulseGuard local development defaults.
# Copy to .env for docker compose / local runs.
# These are DEV-ONLY placeholder values, not secrets. Never commit real credentials.

# --- PostgreSQL ---
POSTGRES_USER=pulseguard
POSTGRES_PASSWORD=pulseguard_dev
POSTGRES_DB=pulseguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL used by backend & ML tooling (inside compose, host is "db")
DATABASE_URL=postgresql+psycopg://pulseguard:pulseguard_dev@localhost:5432/pulseguard

# --- MLflow (used from Phase 3 onward) ---
# 127.0.0.1 (not "localhost"): deterministic IPv4 loopback — avoids dual-stack
# setups where another WSL2-relayed service owns localhost's IPv6 address.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_BACKEND_STORE_URL=postgresql+psycopg://pulseguard:pulseguard_dev@localhost:5432/mlflow
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
# 127.0.0.1 (not "localhost"): deterministic IPv4 loopback — avoids dual-stack
# setups where another WSL2-relayed service owns localhost's IPv6 address.
VITE_API_BASE_URL=http://127.0.0.1:8000
